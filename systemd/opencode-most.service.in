# Managed by OpenCode Most systemd installer. Do not edit in place.
[Unit]
Description=OpenCode Most MCP Bridge
After=network.target
PartOf=opencode-most.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
Environment=PATH=@PATH@
ExecStart=@NODE_BIN@ @REPO_DIR@/dist/cli.js start
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=opencode-most.target
